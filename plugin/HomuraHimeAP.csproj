<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>HomuraHimeArchipelago</AssemblyName>
        <RootNamespace>HomuraHimeAP</RootNamespace>
        <Description>Archipelago randomizer plugin for Homura Hime</Description>
        <Version>0.3.2</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <DebugType>portable</DebugType>
        <!-- Override with: dotnet build -p:GameDir="D:\Games\Homura Hime" -->
        <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Homura Hime</GameDir>
        <ManagedDir>$(GameDir)\HomuraHime_Data\Managed</ManagedDir>
        <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <!-- set -p:DeployToGame=true to copy the dll into BepInEx\plugins after a build -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    </PropertyGroup>

    <ItemGroup>
        <!-- BepInEx 5 + Harmony from the game's own install (no NuGet needed for these) -->
        <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>

        <!-- Unity (the game's own assemblies, so versions always match) -->
        <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(ManagedDir)\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="PlayMaker"><HintPath>$(ManagedDir)\PlayMaker.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Unity.Localization"><HintPath>$(ManagedDir)\Unity.Localization.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Unity.ResourceManager"><HintPath>$(ManagedDir)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>

        <!-- Game libraries used directly (inventory UI filters, JSON) -->
        <Reference Include="Opsive.UltimateInventorySystem"><HintPath>$(ManagedDir)\Opsive.UltimateInventorySystem.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Opsive.Shared.Inventory"><HintPath>$(ManagedDir)\Opsive.Shared.Inventory.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="FMODUnity"><HintPath>$(ManagedDir)\FMODUnity.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Opsive.Shared.Utility"><HintPath>$(ManagedDir)\Opsive.Shared.Utility.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Opsive.Shared.Runtime"><HintPath>$(ManagedDir)\Opsive.Shared.Runtime.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.6.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- shared data contract, generated by tools/build_data.py -->
        <EmbeddedResource Include="..\data\items.json" LogicalName="items.json" />
        <EmbeddedResource Include="..\data\locations.json" LogicalName="locations.json" />
        <EmbeddedResource Include="..\data\custom_texts.json" LogicalName="custom_texts.json" />
        <EmbeddedResource Include="..\resources\ap_assets\color-icon.png" LogicalName="ap-icon.png" />
        <EmbeddedResource Include="..\resources\ap_assets\black-icon.png" LogicalName="ap-icon-black.png" />
    </ItemGroup>

    <!-- Game types in Assembly-CSharp are reached through reflection/Harmony (AccessTools), so a game update
         that renames something produces a logged warning instead of a build break. -->

    <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(OutputPath)Archipelago.MultiClient.Net.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\HomuraHimeArchipelago" ContinueOnError="true" />
        <Message Importance="high" Text="Deployed $(AssemblyName).dll to $(GameDir)\BepInEx\plugins\HomuraHimeArchipelago" />
    </Target>

</Project>




