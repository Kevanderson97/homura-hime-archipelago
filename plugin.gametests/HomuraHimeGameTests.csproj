<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>HomuraHimeGameTests</AssemblyName>
        <RootNamespace>HomuraHimeAP.GameTests</RootNamespace>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>NU1701;CS0618</NoWarn>
        <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Homura Hime</GameDir>
        <ManagedDir>$(GameDir)\HomuraHime_Data\Managed</ManagedDir>
        <OutputPath>bin\$(Configuration)\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.6.0" ExcludeAssets="runtime" /> <!-- the plugin ships it -->
        <PackageReference Include="Surity.Core" Version="2.2.0" />
        <PackageReference Include="Surity.BepInEx" Version="2.2.0" />
        <!-- Surity needs these next to its runner; the game does not ship them -->
        <PackageReference Include="Ben.Demystifier" Version="0.4.1" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Opsive.UltimateInventorySystem"><HintPath>$(ManagedDir)\Opsive.UltimateInventorySystem.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Opsive.Shared.Utility"><HintPath>$(ManagedDir)\Opsive.Shared.Utility.dll</HintPath><Private>false</Private></Reference>
        <ProjectReference Include="..\plugin\HomuraHimeAP.csproj"><Private>false</Private></ProjectReference>
    </ItemGroup>

    <!-- tests are installed as their own BepInEx plugin, next to Surity's runner plugin -->
    <Target Name="DeployGameTests" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
        <ItemGroup>
            <SurityRunner Include="$(NuGetPackageRoot)surity.bepinex\2.2.0\lib\net472\Surity.BepInEx.dll" />
            <SurityCore Include="$(NuGetPackageRoot)surity.core\2.2.0\lib\net472\Surity.Core.dll" />
        </ItemGroup>
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\plugins\HomuraHimeGameTests" />
        <Copy SourceFiles="@(SurityRunner);@(SurityCore);$(PkgBen_Demystifier)\lib\netstandard2.0\Ben.Demystifier.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\Surity" />
        <Message Importance="high" Text="Deployed game tests and the Surity runner to $(GameDir)\BepInEx\plugins" />
    </Target>

</Project>






